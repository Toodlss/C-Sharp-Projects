
@model TheatreCMS3.Areas.Rent.Models.RentalHistory

@{
    ViewBag.Title = "Delete Rental History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="rental-title">Delete Rental History</h2>

<h3 class="rental-confirmation">
    Are you sure you want to delete this rental history?
</h3>

<div class="rental-form rental-delete">

    <h4 class="rental-subtitle">Rental History Details</h4>

    <hr />

    <dl class="rental-details">

        <dt>
            @Html.DisplayNameFor(model => model.Rental)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Rental)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.RentalDamaged)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.RentalDamaged)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DamagesIncurred)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.DamagesIncurred)
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="rental-buttons rental-delete-buttons">

            <input type="submit" value="Delete"
                   class="btn btn-danger" />

            @Html.ActionLink("Back to List", "Index",
                null, new { @class = "btn btn-dark" })

        </div>
    }

</div>
