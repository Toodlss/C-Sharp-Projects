
@model TheatreCMS3.Areas.Rent.Models.RentalHistory

@{
    ViewBag.Title = "Edit Rental History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="rental-title">Edit Rental History</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="rental-form">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.RentalHistoryId)

        <div class="rental-top-row">

            <div class="rental-field">
                @Html.LabelFor(model => model.Rental, "Rental")

                @Html.EditorFor(model => model.Rental,
                    new { htmlAttributes = new { @class = "form-control" } })

                @Html.ValidationMessageFor(model => model.Rental, "",
                    new { @class = "text-danger" })
            </div>

            <div class="rental-checkbox">
                @Html.LabelFor(model => model.RentalDamaged, "Damaged?")

                <div>
                    @Html.EditorFor(model => model.RentalDamaged)

                    @Html.ValidationMessageFor(model => model.RentalDamaged, "",
                        new { @class = "text-danger" })
                </div>
            </div>

        </div>

        <div class="rental-field damages-field">
            <label id="damageLabel" for="DamagesIncurred">
                Damages Incurred
            </label>

            @Html.TextBoxFor(model => model.DamagesIncurred,
                new { @class = "form-control", id = "DamagesIncurred" })

            @Html.ValidationMessageFor(model => model.DamagesIncurred, "",
                new { @class = "text-danger" })
        </div>

        <div class="rental-buttons">
            @Html.ActionLink("Back to List", "Index",
                null, new { @class = "btn btn-dark" })

            <input type="submit" value="Save"
                   class="btn btn-success" />
        </div>

    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
                document.addEventListener("DOMContentLoaded", function () {

                    var damagedCheckbox =
                        document.getElementById("RentalDamaged");

                    var damageLabel =
                        document.getElementById("damageLabel");

                    function updateDamageLabel() {
                        if (damagedCheckbox.checked) {
                            damageLabel.textContent = "Damages Incurred";
                        } else {
                            damageLabel.textContent = "Notes";
                        }
                    }

                    damagedCheckbox.addEventListener(
                        "change", updateDamageLabel
                    );

                    updateDamageLabel();
                });
    </script>
}
